[database]
postgres_username = "app"
postgres_password = "change-me"
postgres_db = "app"
postgres_host = "postgres"
postgres_port = 5432

[s3]
endpoint_url = "http://minio:9000"
public_endpoint_url = "http://localhost:9000"
region = "us-east-1"
access_key = "change-me"
secret_key = "change-me"
bucket = "labka"
max_file_size_bytes = 20971520
url_ttl_seconds = 900
timeout_seconds = 10

[pagination]
default_per_page = 20
max_per_page = 100

[logging]
level = "INFO"

[cors]
origins = ["http://localhost:5173"]

[auth]
jwt_secret = "change-me"
access_token_ttl_minutes = 15
refresh_token_ttl_days = 30
admin_session_ttl_hours = 12
cookie_secure = false
password_min_length = 8
password_max_length = 32

[schedule]
# Окна пар; занятия ставятся только на них.
slots = [
  { number = 1, starts_at = "09:30", ends_at = "11:00" },
  { number = 2, starts_at = "11:15", ends_at = "12:45" },
  { number = 3, starts_at = "13:00", ends_at = "14:30" },
  { number = 4, starts_at = "15:10", ends_at = "16:40" },
  { number = 5, starts_at = "16:55", ends_at = "18:25" },
]
autumn_starts = { month = 9, day = 1 }
autumn_classes_end = { month = 12, day = 30 }
autumn_ends = { month = 1, day = 31 }
spring_starts = { month = 2, day = 1 }
spring_classes_end = { month = 7, day = 10 }
spring_ends = { month = 7, day = 10 }
personal_tasks_max_range_days = 366

[notifications]
reminder_window_hours = 24
reminder_interval_minutes = 5
websocket_ping_seconds = 30

[dashboard]
upcoming_lessons = 3
upcoming_deadlines = 3
courses = 12
lessons_horizon_days = 60

[administration]
max_batch_groups = 30
