      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_database_size_bytes{datname=~\"$db\"}",
          "legendFormat": "{{datname}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
