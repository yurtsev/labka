    },
    {
      "type": "timeseries",
      "title": "Временные файлы и дедлоки",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_temp_bytes{datname=~\"$db\"}[$__rate_interval]))",
          "legendFormat": "temp-файлы, байт/с",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(increase(pg_stat_database_deadlocks{datname=~\"$db\"}[$__rate_interval]))",
