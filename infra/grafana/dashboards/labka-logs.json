{
  "uid": "labka-logs",
  "title": "Логи",
  "tags": [
    "labka",
    "logs"
  ],
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Контейнер",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "container",
          "refId": "v"
        },
        "definition": "container",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "level",
        "label": "Уровень",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "level",
          "refId": "v"
        },
        "definition": "level",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "requests",
        "label": "Логи запросов",
        "type": "custom",
        "query": "Показывать : a^,Скрывать : http.request_completed",
        "current": {
          "text": "Показывать",
          "value": "a^"
        },
        "options": [
          {
            "text": "Показывать",
            "value": "a^",
            "selected": true
          },
          {
            "text": "Скрывать",
            "value": "http.request_completed",
            "selected": false
          }
        ]
      },
      {
        "name": "search",
        "label": "Поиск по тексту",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "request_id",
        "label": "request_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Ошибок за период",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=~\"$container\", level=~\"ERROR|CRITICAL\"} [$__range]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "Предупреждений за период",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=~\"$container\", level=\"WARNING\"} [$__range]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Объём логов по уровням",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{level}}",
          "expr": "sum by (level) (count_over_time({container=~\"$container\", level=~\"$level\"} [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CRITICAL"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WARNING"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "INFO"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Ошибки по контейнерам",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{container}}",
          "expr": "sum by (container) (count_over_time({container=~\"$container\", level=~\"ERROR|CRITICAL\"} [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "logs",
      "title": "Ошибки",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"$container\", level=~\"ERROR|CRITICAL\"} | json | line_format `{{ if .message }}{{ .src }}  {{ .message }}{{ if .http_method }}  {{ .http_method }} {{ .http_path }}{{ end }}{{ if .http_status_code }} → {{ .http_status_code }} за {{ .http_duration_ms }} мс{{ end }}{{ if .error_code }}  {{ .error_status }} {{ .error_code }}{{ end }}{{ if .request_id }}  [{{ .request_id }}]{{ end }}{{ if .exception }}\n{{ .exception }}{{ end }}{{ else }}{{ __line__ }}{{ end }}`"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "description": "ERROR и CRITICAL вместе с traceback",
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "logs",
      "title": "Упавшие и медленные запросы",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=\"labka_backend\"} |= \"http.request_completed\" | json | http_status_code >= 500 or http_duration_ms > 1000 | line_format `{{ if .message }}{{ .src }}  {{ .message }}{{ if .http_method }}  {{ .http_method }} {{ .http_path }}{{ end }}{{ if .http_status_code }} → {{ .http_status_code }} за {{ .http_duration_ms }} мс{{ end }}{{ if .error_code }}  {{ .error_status }} {{ .error_code }}{{ end }}{{ if .request_id }}  [{{ .request_id }}]{{ end }}{{ if .exception }}\n{{ .exception }}{{ end }}{{ else }}{{ __line__ }}{{ end }}`"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "description": "Ответы 5xx и запросы дольше секунды. request_id из строки — в фильтр сверху, чтобы увидеть весь запрос",
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "logs",
      "title": "Все логи",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"$container\", level=~\"$level\"} !~ \"$requests\" |~ \"(?i)$search\" | json | request_id=~\"$request_id.*\" | line_format `{{ if .message }}{{ .src }}  {{ .message }}{{ if .http_method }}  {{ .http_method }} {{ .http_path }}{{ end }}{{ if .http_status_code }} → {{ .http_status_code }} за {{ .http_duration_ms }} мс{{ end }}{{ if .error_code }}  {{ .error_status }} {{ .error_code }}{{ end }}{{ if .request_id }}  [{{ .request_id }}]{{ end }}{{ if .exception }}\n{{ .exception }}{{ end }}{{ else }}{{ __line__ }}{{ end }}`"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "description": "Строка собрана из JSON; все поля — в деталях записи по клику",
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 20
      }
    }
  ]
}
