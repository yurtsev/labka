# Скопируйте в .env (он в .gitignore) и поправьте под своё окружение.

# Лимиты форм. Должны совпадать с backend/config.toml: сервер всё равно проверит сам,
# а здесь они нужны, чтобы показать понятную ошибку под полем до отправки.
# [s3] max_file_size_bytes
VITE_MAX_FILE_SIZE_BYTES=20971520
# [auth] password_min_length / password_max_length
VITE_PASSWORD_MIN_LENGTH=8
VITE_PASSWORD_MAX_LENGTH=32
